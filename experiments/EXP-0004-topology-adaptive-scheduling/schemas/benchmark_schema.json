{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SynapticContinuum Benchmark Result Schema",
  "version": "1.0.0",
  "type": "object",
  "required": [
    "schema_version",
    "benchmark_id",
    "run_id",
    "build_id",
    "semantic_class",
    "hardware_environment",
    "graph_configuration",
    "execution_configuration",
    "workload_metrics",
    "timing_breakdown",
    "resource_metrics",
    "validation"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "benchmark_id": {
      "type": "string",
      "minLength": 1,
      "description": "Immutable canonical identifier of the workload parameters, topology, scale, and seed (invariant across W, engines, and compiler builds)"
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "description": "Unique identifier for this specific execution (benchmark_id + build_id + engine + queue + representation + partitioner + W)"
    },
    "build_id": {
      "type": "string",
      "enum": [
        "portable_o3",
        "znver3_o3"
      ]
    },
    "workload_name": {
      "type": "string"
    },
    "semantic_class": {
      "type": "string",
      "enum": [
        "exact",
        "fixed-dt-approx",
        "relaxed-model",
        "trace-replay-only",
        "quantized-approx",
        "procedural-synthetic"
      ]
    },
    "hardware_environment": {
      "type": "object",
      "required": [
        "os",
        "cpu_model",
        "physical_cores",
        "logical_threads",
        "total_ram_bytes",
        "compiler",
        "compiler_flags"
      ],
      "properties": {
        "os": { "type": "string" },
        "cpu_model": { "type": "string" },
        "physical_cores": { "type": "integer", "minimum": 1 },
        "logical_threads": { "type": "integer", "minimum": 1 },
        "l3_cache_bytes": { "type": "integer" },
        "total_ram_bytes": { "type": "integer" },
        "available_ram_bytes": { "type": "integer" },
        "compiler": { "type": "string" },
        "compiler_flags": { "type": "string" },
        "git_commit_sha": { "type": "string" }
      }
    },
    "graph_configuration": {
      "type": "object",
      "required": [
        "num_nodes",
        "num_edges",
        "topology_type",
        "graph_checksum",
        "input_events_checksum"
      ],
      "properties": {
        "num_nodes": { "type": "integer", "minimum": 1 },
        "num_edges": { "type": "integer", "minimum": 0 },
        "mean_out_degree": { "type": "integer", "minimum": 0 },
        "topology_type": { "type": "string" },
        "graph_checksum": { "type": "string", "pattern": "^0x[0-9a-fA-F]{16}$" },
        "input_events_checksum": { "type": "string", "pattern": "^0x[0-9a-fA-F]{16}$" },
        "representation": { "type": "string" },
        "state_layout": { "type": "string" },
        "history_capacity_L": { "type": "integer", "minimum": 0 },
        "weight_quantization_max_abs_err": { "type": "number", "minimum": 0.0 },
        "weight_quantization_rmse": { "type": "number", "minimum": 0.0 },
        "delay_quantization_max_abs_err": { "type": "number", "minimum": 0.0 },
        "delay_quantization_rmse": { "type": "number", "minimum": 0.0 },
        "clustering_coefficient": { "type": "number" },
        "characteristic_path_length": { "type": "number" },
        "modularity": { "type": "number" },
        "edge_cut_fraction": { "type": "number" }
      }
    },
    "execution_configuration": {
      "type": "object",
      "required": [
        "engine_id",
        "algorithm_family",
        "num_workers",
        "num_regions"
      ],
      "properties": {
        "engine_id": { "type": "string" },
        "algorithm_family": { "type": "string" },
        "queue_family": { "type": "string" },
        "partitioner": { "type": "string" },
        "num_workers": { "type": "integer", "minimum": 1 },
        "num_regions": { "type": "integer", "minimum": 1 },
        "t_max": { "type": "number" },
        "min_delay": { "type": "number" },
        "max_delay": { "type": "number" },
        "order_relaxation_epsilon": { "type": "number" },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "timed_repetitions": { "type": "integer", "minimum": 1 }
      }
    },
    "workload_metrics": {
      "type": "object",
      "required": [
        "total_events_processed",
        "total_spikes",
        "total_edges_traversed"
      ],
      "properties": {
        "active_fraction": { "type": "number" },
        "external_events": { "type": "integer" },
        "total_events_processed": { "type": "integer", "minimum": 0 },
        "total_edges_traversed": { "type": "integer", "minimum": 0 },
        "total_spikes": { "type": "integer", "minimum": 0 },
        "cross_region_events": { "type": "integer", "minimum": 0 },
        "cross_region_event_fraction": { "type": "number" },
        "total_migrations": { "type": "integer", "minimum": 0 },
        "migrated_queue_events": { "type": "integer", "minimum": 0 },
        "migrated_mailbox_events": { "type": "integer", "minimum": 0 },
        "migration_pause_sec": { "type": "number" }
      }
    },
    "timing_breakdown": {
      "type": "object",
      "required": [
        "wall_time_sim_sec",
        "wall_time_total_sec",
        "events_per_sec"
      ],
      "properties": {
        "wall_time_sim_sec": { "type": "number", "minimum": 0.0 },
        "median_sim_sec": { "type": "number", "minimum": 0.0 },
        "std_sim_sec": { "type": "number", "minimum": 0.0 },
        "rep_wall_sim_sec": {
          "type": "array",
          "items": { "type": "number", "minimum": 0.0 }
        },
        "wall_time_total_sec": { "type": "number", "minimum": 0.0 },
        "thread_spawn_join_overhead_sec": { "type": "number" },
        "events_per_sec": { "type": "number", "minimum": 0.0 },
        "worker_active_sec": {
          "type": "array",
          "items": { "type": "number" }
        },
        "worker_barrier1_sec": {
          "type": "array",
          "items": { "type": "number" }
        },
        "worker_mailbox_sec": {
          "type": "array",
          "items": { "type": "number" }
        },
        "worker_barrier2_sec": {
          "type": "array",
          "items": { "type": "number" }
        }
      }
    },
    "resource_metrics": {
      "type": "object",
      "required": [
        "peak_rss_bytes",
        "hardware_perf_counters_available"
      ],
      "properties": {
        "peak_rss_bytes": { "type": "integer", "minimum": 0 },
        "rss_before_build_bytes": { "type": "integer", "minimum": 0 },
        "rss_after_build_bytes": { "type": "integer", "minimum": 0 },
        "rss_after_sim_bytes": { "type": "integer", "minimum": 0 },
        "graph_payload_bytes": { "type": "integer", "minimum": 0 },
        "minor_page_faults": { "type": "integer" },
        "major_page_faults": { "type": "integer" },
        "voluntary_context_switches": { "type": "integer" },
        "involuntary_context_switches": { "type": "integer" },
        "hardware_perf_counters_available": { "type": "boolean" },
        "perf_notes": { "type": "string" }
      }
    },
    "validation": {
      "type": "object",
      "required": [
        "state_digest",
        "reference_serial_digest",
        "parity_with_serial"
      ],
      "properties": {
        "state_digest": { "type": "string" },
        "reference_serial_digest": { "type": ["string", "null"] },
        "parity_with_serial": { "type": ["boolean", "null"] },
        "exact_spike_matches": { "type": "integer" },
        "backward_time_events": { "type": "integer" },
        "out_of_order_worker_events": { "type": "integer" },
        "spike_count_error": { "type": "integer" },
        "spike_timestamp_rmse": { "type": "number" },
        "potential_rmse": { "type": "number" },
        "temporal_discrimination_accuracy": { "type": "number" },
        "temporal_discrimination_passed": { "type": "boolean" }
      }
    }
  }
}
